# Configurações do Cérebro Nexus
# Copie este arquivo para .env e preencha com seus valores locais

# URL do Web App publicado no Google Apps Script (terminada em /exec)
VITE_SHEETS_URL=https://script.google.com/macros/s/SEU_SCRIPT_ID/exec

# OAuth 2.0 Client ID do Google Cloud Console (tipo "Aplicativo da Web")
VITE_GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
